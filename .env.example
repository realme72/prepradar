# Never commit the real .env
DATABASE_URL=postgresql://localhost:5432/prepradar
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-5.4-mini
JUDGE_REASONING=low
# Search: tavily (default) | serper | brave — switch when a quota runs out
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
DEDUPE_THRESHOLD=0.88
DEDUPE_JUDGE=0.80
TOPIC_AUTO_MERGE=0.92
TOPIC_CANDIDATE=0.70
