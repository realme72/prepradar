# Copy to .dev.vars (gitignored) for `npm run dev`. Razorpay TEST mode values only.
# In production these are set with `npx wrangler secret put <NAME>`, never in a file.

# Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web).
# Not secret (it's in every page that shows the button), but specific to your project.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Razorpay Dashboard (Test Mode) → Account & Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Razorpay Dashboard → Subscriptions → Plans → create "₹49 monthly", copy its id
RAZORPAY_PLAN_ID=plan_xxxxxxxxxxxxxx
# Razorpay Dashboard → Webhooks → the secret you type when adding the webhook
RAZORPAY_WEBHOOK_SECRET=change-me

# Any long random string; signs session tokens. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me

# Optional: lets visitors request companies that aren't on the site. GitHub → Settings →
# Developer settings → Fine-grained tokens: only the prepradar repo, permission
# "Actions: Read and write", nothing else. Leave empty locally unless you want a local
# request to start a real collect run.
GITHUB_TOKEN=
