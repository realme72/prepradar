# Copy to .dev.vars (gitignored) for `npm run dev`. Use Razorpay TEST mode keys only
# (Dashboard → switch to Test Mode → Account & Settings → API Keys).
# In production these are set with `npx wrangler secret put <NAME>`, never in a file.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Any long random string; signs the access tokens buyers keep in their browser.
# Generate one with: openssl rand -hex 32
ACCESS_SECRET=change-me
