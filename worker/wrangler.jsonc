// One Worker serves the whole live site: the built React app as static assets, plus
// the few /api routes that need a secret (Razorpay keys) or locked content (KV).
{
  "name": "prepradar",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // CONTENT: each company's locked data (`npm run data:upload`). USERS: one record per
  // signed-in user (their subscription). REQUESTS: companies visitors asked for, and
  // per-day request counts. Create each once with `npx wrangler kv namespace create
  // CONTENT` (and USERS, REQUESTS), and paste the ids here. The ids aren't secret.
  "kv_namespaces": [
    { "binding": "CONTENT", "id": "7c2d32c93d0d45649cfab9d495a0f908" },
    { "binding": "USERS", "id": "646ba601d4b64ef7a9f520ecb4aa94dc" },
    { "binding": "REQUESTS", "id": "f3e6ebdbce2248cbaac047227a4dc1c0" }
  ],
  // The repo whose collect workflow a company request starts (see GITHUB_TOKEN).
  "vars": { "GITHUB_REPO": "realme72/prepradar" }
}
