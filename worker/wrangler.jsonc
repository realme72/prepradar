// One Worker serves the whole live site: the built React app as static assets, plus
// the few /api routes that need a secret (Razorpay keys) or locked content (KV).
{
  "name": "prepradar",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // CONTENT: each company's locked data (`npm run data:upload`). USERS: one record per
  // signed-in user (their subscription). Create each once with
  // `npx wrangler kv namespace create CONTENT` (and USERS), and paste the ids here.
  "kv_namespaces": [
    { "binding": "CONTENT", "id": "REPLACE_WITH_CONTENT_NAMESPACE_ID" },
    { "binding": "USERS", "id": "REPLACE_WITH_USERS_NAMESPACE_ID" }
  ]
}
